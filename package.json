{
  "name": "campusgrid-timetable",
  "version": "1.0.0",
  "description": "Offline college timetable studio",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "edu.college.campusgrid",
    "productName": "CampusGrid Timetable",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "src/ui/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "CampusGrid-Timetable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}